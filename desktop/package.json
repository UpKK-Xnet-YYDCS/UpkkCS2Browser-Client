{
  "name": "xproj-desktop",
  "private": true,
  "version": "1.7.0",
  "description": "XProj 游戏服务器浏览器桌面客户端",
  "type": "module",
  "engines": {
    "node": ">=24.11 <27",
    "npm": ">=11"
  },
  "overrides": {
    "eslint-plugin-react-hooks": {
      "@babel/core": "8.0.1",
      "@babel/parser": "8.0.4"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/typescript-7/bin/tsc -b && vite build && npm run check:performance",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:contracts": "bash sync-version.sh --check && node scripts/check-contracts.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "typecheck": "node ./node_modules/typescript-7/bin/tsc -b",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --features devtools",
    "tauri:build": "tauri build",
    "tauri:build:devtools": "tauri build --features devtools"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}
