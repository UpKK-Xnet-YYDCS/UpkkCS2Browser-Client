{
  "name": "xproj-desktop",
  "private": true,
  "version": "1.7.0",
  "description": "XProj 游戏服务器浏览器桌面客户端",
  "type": "module",
  "engines": {
    "node": ">=24.11 <27",
    "npm": ">=11"
  },
  "overrides": {
    "eslint-plugin-react-hooks": {
      "@babel/core": "8.1.0",
      "@babel/parser": "8.1.0"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/typescript-7/bin/tsc -b && vite build && npm run check:performance",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:contracts": "bash sync-version.sh --check && node scripts/check-contracts.mjs && node ../scripts/check-ai-contracts.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --import ./scripts/test-browser-storage.mjs --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "typecheck": "node ./node_modules/typescript-7/bin/tsc -b",
    "windows:acceptance": "node scripts/windows-acceptance.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --features devtools",
    "tauri:build": "tauri build",
    "tauri:build:devtools": "tauri build --features devtools"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-http": "2.8.3",
    "@tauri-apps/plugin-notification": "2.8.0",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-shell": "2.6.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "remark-gfm": "^4.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
